# Deny by default. Explicitly admit only reviewed public source artifacts.
*

!.gitignore
!.gitattributes
!README.md

!docs/
docs/*
!docs/SPOOLMAN-BAMBU-OPERATIONS.md

!scripts/
scripts/*
!scripts/spoolman/
scripts/spoolman/*
!scripts/spoolman/*.sh
!scripts/spoolman/*.ps1
!scripts/spoolman/*.yml
!scripts/spoolman/tests/
scripts/spoolman/tests/*
!scripts/spoolman/tests/*.ps1

# Defense in depth for common secret, state, and backup formats.
**/.env
**/.env.*
**/stack.env
**/*secret*
**/*credential*
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*.jks
**/*.kdbx
**/*.sqlite*
**/*.db
**/*.dump
**/*.sql
**/*.bak
**/*.backup
**/*.tar
**/*.tar.*
**/*.zip
**/*.7z
**/*.age
**/*.gpg
**/*.dpapi*
**/evidence/
**/.remember/
**/.superpowers/
